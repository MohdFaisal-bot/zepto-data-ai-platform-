# Create and switch to a feature branch
git checkout -b feature/platform-scaffold

# Commit initial files (do this at least twice on the branch)
git add .
git commit -m "feat(scaffold): initialize module directories and requirements"
git commit -m "docs(scaffold): add initial project structure notes"

# Merge back into main
git checkout main
git merge --no-ff feature/platform-scaffold -m "merge: integrate platform-scaffold into main"
